{
	"name": "svelte-universal-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && bun run lint:oxlint && eslint .",
		"lint:oxlint": "oxlint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"check:i18n": "inlang check --project ./project.inlang",
		"optimize-images": "bun scripts/optimize-images.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/archivo": "^5.3.0",
		"@iconify-json/lucide": "^1.2.143",
		"@iconify-json/simple-icons": "^1.2.100",
		"@iconify/tailwind4": "^1.2.3",
		"@inlang/cli": "^3.4.0",
		"@inlang/paraglide-js": "^2.27.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@oxlint/plugins": "1.87.0",
		"@sveltejs/adapter-cloudflare": "^8",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"bits-ui": "^2.20.0",
		"cn": "^0.3.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"oxlint": "1.87.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"sharp": "0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.166.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0",
		"posthog-js": "^1.453.2",
		"resend": "^6.34.1",
		"zod": "^4.6.5"
	}
}
