{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itsogi",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-22",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		}
	}
}
